    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photos Connector benötigt Zugriff auf deine Fotomediathek, damit du Fotos, Videos und Alben aus Apple Fotos in Nextcloud übernehmen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector needs access to your photo library so you can import photos, videos, and albums from Apple Photos into Nextcloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector necesita acceder a tu fototeca para poder importar fotos, vídeos y álbumes de Fotos de Apple a Nextcloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector doit accéder à votre photothèque pour vous permettre d’importer des photos, des vidéos et des albums de Photos dans Nextcloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector heeft toegang nodig tot je fotobibliotheek, zodat je foto’s, video’s en albums uit Apple Foto’s in Nextcloud kunt importeren."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector necessita de acesso à sua fototeca para que possa importar fotografias, vídeos e álbuns da app Fotografias da Apple para o Nextcloud."
          }
        }
      }
    }
  },
  "version" : "1.3"
