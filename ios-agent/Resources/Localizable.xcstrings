        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De toegang tot foto’s is beperkt voor dit apparaat of deze account."
          }
        }
      }
    },
    "Der Zugriff wurde abgelehnt. Du kannst ihn in den iPhone-Einstellungen unter Datenschutz & Sicherheit → Fotos ändern." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photo access was denied. You can change it in iPhone Settings under Privacy & Security > Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se ha denegado el acceso. Puedes cambiarlo en Ajustes del iPhone, en Privacidad y seguridad → Fotos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
