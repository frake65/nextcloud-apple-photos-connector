    },
    "Der Zugriff auf Fotos ist für dieses Gerät oder Konto eingeschränkt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photo access is restricted for this device or account."
          }
        },
        "es" : {
          "stringUnit" : {
