    "Das App-Passwort wird im iOS-Schlüsselbund gespeichert. Serveradresse, Benutzername und Source-ID liegen in den App-Einstellungen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Your app password is stored in the iOS Keychain. The server address, username, and Source-ID are stored in the app’s settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La contraseña de aplicación se guarda en el llavero de iOS. La dirección del servidor, el nombre de usuario y el ID de origen se guardan en los ajustes de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le mot de passe d’application est stocké dans le trousseau iOS. L’adresse du serveur, le nom d’utilisateur et l’identifiant Source-ID figurent dans les réglages de l’app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het appwachtwoord wordt bewaard in de iOS-sleutelhanger. Het serveradres, de gebruikersnaam en Source-ID staan in de appinstellingen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A palavra-passe da aplicação é guardada no Porta-chaves do iOS. O endereço do servidor, o nome de utilizador e a Source-ID são guardados nas definições da aplicação."
          }
        }
      }
    },
