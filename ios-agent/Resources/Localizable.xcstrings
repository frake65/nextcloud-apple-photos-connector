    "Photos Connector benötigt Zugriff auf deine Fotomediathek, damit du Fotos, Videos und Alben aus Apple Fotos in Nextcloud ansehen kannst." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector needs access to your photo library so you can view photos, videos, and albums from Apple Photos in Nextcloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector necesita acceder a tu fototeca para que puedas ver en Nextcloud las fotos, los vídeos y los álbumes de Fotos de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector doit accéder à votre photothèque pour vous permettre de consulter dans Nextcloud les photos, vidéos et albums de Photos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector heeft toegang nodig tot je fotobibliotheek, zodat je foto’s, video’s en albums uit Apple Foto’s in Nextcloud kunt bekijken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O Photos Connector precisa de aceder à sua fototeca para que possa ver fotografias, vídeos e álbuns das Fotografias da Apple no Nextcloud."
          }
        }
      }
    },
    "Photos Connector benötigt Zugriff auf deine Fotomediathek, damit du Fotos, Videos und Alben aus Apple Fotos zur Nextcloud hochladen kannst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector needs access to your photo library so you can upload photos, videos, and albums from Apple Photos to Nextcloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector necesita acceder a tu fototeca para que puedas subir fotos, vídeos y álbumes de Fotos de Apple a Nextcloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector doit accéder à votre photothèque pour vous permettre de transférer les photos, vidéos et albums de Photos vers Nextcloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos Connector heeft toegang nodig tot je fotobibliotheek, zodat je foto’s, video’s en albums uit Apple Foto’s naar Nextcloud kunt uploaden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O Photos Connector precisa de aceder à sua fototeca para que possa carregar fotografias, vídeos e álbuns das Fotografias da Apple para o Nextcloud."
          }
        }
      }
    },
